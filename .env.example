# Kalendee production environment (docker-compose.yml).
#
# HOCON-file-first: non-secret settings belong in application.conf (mounted at
# /config/application.conf). This file should hold SECRETS and the few
# container-level knobs that compose itself consumes. Every KALENDEE_* variable
# documented below is an optional override for a key that already exists in
# application.conf, so leaving one commented out keeps the HOCON value.
#
#   cp .env.example .env
#   cp application.conf.example application.conf
#   # edit both, then:
#   docker compose up -d
#
# Never commit .env (it is git-ignored).

# ---------------------------------------------------------------------------
# (a) Required secrets -- no safe default, set real values.
# ---------------------------------------------------------------------------

# PostgreSQL password. Used both to create the postgres role and (via
# KALENDEE_DATABASE_PASSWORD) by the server. The two must match.
POSTGRES_PASSWORD=change-me-strong-database-password
KALENDEE_DATABASE_PASSWORD=change-me-strong-database-password

# Password for the admin seeded on first startup. Set a strong value.
KALENDEE_ADMIN_PASSWORD=change-me-strong-admin-password

# Token-encryption key for external calendar connections. Required before any
# OAuth provider can be connected. Generate with: openssl rand -base64 32
# KALENDEE_SECRET_KEY=

# ---------------------------------------------------------------------------
# (b) Optional overrides -- defaults live in application.conf / the image.
# ---------------------------------------------------------------------------

# --- Config file -----------------------------------------------------------
# Path to the HOCON file the container loads. Set this and mount it at
# /config/application.conf (docker-compose.yml already mounts ./application.conf
# there). If unset, the entrypoint also auto-detects a file at that path, then
# falls back to the baked /app/application.conf.
# KALENDEE_CONFIG=/config/application.conf

# --- Server bind -----------------------------------------------------------
# HOCON defaults are ktor.deployment.port=8080 and host=0.0.0.0.
# KALENDEE_HTTP_PORT=8080
# KALENDEE_HTTP_HOST=0.0.0.0

# --- Database connection ---------------------------------------------------
# Defaults: jdbc:postgresql://postgres:5432/kalendee, user kalendee.
# KALENDEE_DATABASE_URL=jdbc:postgresql://postgres:5432/kalendee
# KALENDEE_DATABASE_USER=kalendee

# --- Public URL ------------------------------------------------------------
# Canonical https:// URL used in emails, RSS, and OAuth redirects. Prefer
# setting app.baseUrl in application.conf; this is the env fallback.
# KALENDEE_PUBLIC_URL=https://calendar.example.com

# --- Session / auth tuning -------------------------------------------------
# KALENDEE_AUTH_SESSION_DAYS=30
# KALENDEE_SESSION_COOKIE_NAME=kalendee_session
# Require HTTPS for the session cookie. Keep true behind a TLS proxy.
# KALENDEE_COOKIE_SECURE=true
# "first-user", "open", or "closed".
# KALENDEE_AUTH_REGISTRATION=first-user
# "required", "optional", or "off".
# KALENDEE_AUTH_EMAIL_VERIFICATION=optional
# KALENDEE_AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
# KALENDEE_ADMIN_USERNAME=admin
# KALENDEE_SUPERADMIN_USERNAME=
# KALENDEE_AUTH_OAUTH_REGISTRATION=false
# KALENDEE_ARGON2_MEMORY_KIB=19456
# KALENDEE_ARGON2_ITERATIONS=2
# KALENDEE_ARGON2_PARALLELISM=1

# --- App behavior ----------------------------------------------------------
# Anonymous access to public calendars: "public" or "signed_in".
# KALENDEE_PUBLIC_ACCESS=public
# Demo seeding is for development/screenshots only; never enable here.
# KALENDEE_SEED_DEMO=false
# KALENDEE_DEVELOPMENT=false

# --- External calendars (OAuth) --------------------------------------------
# Redirect URI: <public URL>/api/v1/oauth/discord/callback
# KALENDEE_DISCORD_CLIENT_ID=
# KALENDEE_DISCORD_CLIENT_SECRET=
# Bot token for reading guild scheduled events; invite the bot first.
# KALENDEE_DISCORD_BOT_TOKEN=
# Redirect URI: <public URL>/api/v1/oauth/google/callback
# KALENDEE_GOOGLE_CLIENT_ID=
# KALENDEE_GOOGLE_CLIENT_SECRET=
# Optional key-rotation map (JSON): {"1":"<base64>","2":"<base64>"}
# KALENDEE_SECRET_KEYS=

# --- Outgoing mail ---------------------------------------------------------
# provider is "smtp", "cloudflare", "mailgun", or "log"; blank auto-detects.
# Configure it in application.conf, and put only the credentials here.
# KALENDEE_MAIL_ENABLED=false
# KALENDEE_MAIL_PROVIDER=
# SMTP:
# KALENDEE_SMTP_HOST=smtp.example.com
# KALENDEE_SMTP_PORT=587
# KALENDEE_SMTP_USER=calendar@example.com
# KALENDEE_SMTP_PASSWORD=change-me
# KALENDEE_SMTP_STARTTLS=true
# KALENDEE_MAIL_FROM="Kalendee <no-reply@example.com>"
# Cloudflare Email Routing bridge (workers/mailer). Its send_email binding is a
# paid Email Routing feature; Mailgun below is the practical non-SMTP option:
# KALENDEE_MAIL_CLOUDFLARE_ENDPOINT=https://kalendee-mailer.<subdomain>.workers.dev
# KALENDEE_MAIL_CLOUDFLARE_TOKEN=change-me
# KALENDEE_MAIL_CLOUDFLARE_TIMEOUT_SECONDS=10
# Mailgun HTTP API (secret key + verified sending domain):
# KALENDEE_MAILGUN_API_KEY=change-me
# KALENDEE_MAILGUN_DOMAIN=mg.example.com
# KALENDEE_MAILGUN_REGION=us
# KALENDEE_MAILGUN_BASE_URL=
# KALENDEE_MAILGUN_TIMEOUT_SECONDS=10

# --- Avatar storage --------------------------------------------------------
# Image default is /data/avatars, backed by the kalendee-avatars volume.
# KALENDEE_AVATAR_DIR=/data/avatars
# Public base URL for avatars (R2/CDN). When set, avatar GETs 302-redirect here.
# KALENDEE_STORAGE_PUBLIC_URL=
# Cloudflare R2 / S3-compatible backend (see application.conf.example):
# KALENDEE_S3_ENABLED=false
# KALENDEE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# KALENDEE_S3_REGION=auto
# KALENDEE_S3_BUCKET=kalendee
# KALENDEE_S3_ACCESS_KEY=change-me
# KALENDEE_S3_SECRET_KEY=change-me
# KALENDEE_S3_PATH_STYLE=true

# --- Keel web pack ---------------------------------------------------------
# Leave unset in production: the built pack is bundled in the image.
# KALENDEE_KEEL_PACK=/some/exploded/pack

# ---------------------------------------------------------------------------
# (c) Compose-only variables -- consumed by docker-compose.yml, not the server.
# ---------------------------------------------------------------------------

# Image tag to run from docker.yuri.capital: "latest" or a pinned version.
KALENDEE_IMAGE_TAG=latest

# Host port published for the server (container port is always 8080).
# KALENDEE_HOST_PORT=8080

# Database name/role used to bootstrap the postgres service. The server's
# KALENDEE_DATABASE_URL/USER should reference the same names.
POSTGRES_DB=kalendee
POSTGRES_USER=kalendee
