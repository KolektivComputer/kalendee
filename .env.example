# Kalendee production environment.
#
# Read by docker-compose.yml and passed into the kalendee container:
#
#   cp .env.example .env
#   # edit the values below, then:
#   docker compose up -d
#
# Variables prefixed KALENDEE_ are understood by the server; see
# server/src/main/resources/application.conf and application.conf.example for
# advanced/HOCON configuration.

# Image tag to run from docker.yuri.capital: "latest" or a pinned release version.
KALENDEE_IMAGE_TAG=latest

# Host port to publish. Uncomment to change (defaults to 8080).
# KALENDEE_HOST_PORT=8080

# Optional: full HOCON config file mounted at /config/application.conf.
# Uncomment together with the volume in docker-compose.yml. See
# application.conf.example.
# KALENDEE_CONFIG=/config/application.conf

# --- PostgreSQL -------------------------------------------------------------
# Used by the postgres service to create the database.
POSTGRES_DB=kalendee
POSTGRES_USER=kalendee
POSTGRES_PASSWORD=change-me-strong-database-password

# The server's JDBC connection. Keep the user and password identical to the
# POSTGRES_* values above.
KALENDEE_DATABASE_URL=jdbc:postgresql://postgres:5432/kalendee
KALENDEE_DATABASE_USER=kalendee
KALENDEE_DATABASE_PASSWORD=change-me-strong-database-password

# --- First admin account ----------------------------------------------------
# Seeded on startup when the database has no admin yet.
KALENDEE_ADMIN_USERNAME=admin
KALENDEE_ADMIN_PASSWORD=change-me-strong-admin-password

# --- Public URL -------------------------------------------------------------
# Used in emails and generated links. Include the scheme and host.
KALENDEE_PUBLIC_URL=https://calendar.example.com

# --- Optional server behavior ----------------------------------------------
# Send session cookies only over HTTPS (defaults to true when unset).
# KALENDEE_COOKIE_SECURE=true
# Registration policy: "first-user", "open", or "closed".
# KALENDEE_AUTH_REGISTRATION=first-user
# Anonymous access to public calendars: "public" or "signed_in".
# KALENDEE_PUBLIC_ACCESS=public
# Seed a demo user with sample calendars and events on startup. For local
# development and screenshots only; never enable in production.
# KALENDEE_SEED_DEMO=false

# --- External calendars (optional) -----------------------------------------
# Discord OAuth app for linking calendars. The provider stays disabled until
# its client id is set. Redirect URI:
# <KALENDEE_PUBLIC_URL>/api/v1/oauth/discord/callback
# KALENDEE_DISCORD_CLIENT_ID=
# KALENDEE_DISCORD_CLIENT_SECRET=
# Bot token for reading guild scheduled events. Invite the bot to the guild
# first; user linking works without it.
# KALENDEE_DISCORD_BOT_TOKEN=
# Token encryption key. Generate with: openssl rand -base64 32
# Required before any provider can be connected; without it connect attempts fail.
# KALENDEE_SECRET_KEY=
# Optional key-rotation map (JSON): {"1":"<base64>","2":"<base64>"}
# KALENDEE_SECRET_KEYS=
# Allow OAuth sign-ins to create new accounts (still gated by registration).
# KALENDEE_AUTH_OAUTH_REGISTRATION=false

# --- Outgoing mail (optional) ----------------------------------------------
KALENDEE_MAIL_ENABLED=false
# KALENDEE_SMTP_HOST=smtp.example.com
# KALENDEE_SMTP_PORT=587
# KALENDEE_SMTP_USER=calendar@example.com
# KALENDEE_SMTP_PASSWORD=change-me
# KALENDEE_MAIL_FROM="Kalendee <no-reply@example.com>"
# KALENDEE_SMTP_STARTTLS=true

# --- Avatar storage (optional) ---------------------------------------------
# The image default is /data/avatars, backed by the kalendee-avatars volume.
# KALENDEE_AVATAR_DIR=/data/avatars
# Or store avatars in S3-compatible object storage:
# KALENDEE_S3_ENABLED=false
# KALENDEE_S3_ENDPOINT=https://s3.example.com
# KALENDEE_S3_REGION=us-east-1
# KALENDEE_S3_BUCKET=kalendee
# KALENDEE_S3_ACCESS_KEY=change-me
# KALENDEE_S3_SECRET_KEY=change-me
# KALENDEE_S3_PATH_STYLE=true

# For advanced options (auth tuning, Argon2, superadmin, ...) mount a full
# HOCON file: see application.conf.example.
