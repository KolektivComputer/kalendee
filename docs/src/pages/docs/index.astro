---
import { getCollection, type CollectionEntry } from "astro:content";

import CardGrid from "@kolektiv/common-docs-chrome/astro/CardGrid.astro";
import DocsCard from "@kolektiv/common-docs-chrome/astro/DocsCard.astro";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { docs } from "../../docs-chrome";
import { docsPath, navSectionLabel, slugFromId, sortDocs } from "../../utils";

const entries = sortDocs(await getCollection("docs"));

// Group entries by their nav section, preserving nav order (sorted entries are
// already ordered nav-first, so first-seen group order matches the sidebar).
const groups = new Map<string, CollectionEntry<"docs">[]>();
for (const entry of entries) {
  const label = navSectionLabel(slugFromId(entry.id));
  const group = groups.get(label) ?? [];
  group.push(entry);
  groups.set(label, group);
}
---

<DocsLayout
  title="Documentation"
  description="Guides for running, configuring, and integrating Kalendee: product walkthroughs plus self-hosting and operations."
>
  <h1>Documentation</h1>
  <p class="text-lg text-base-content/75">
    Product guides and self-hosting runbooks for Kalendee. The sidebar shows the full planned
    structure; pages appear here as they are authored.
  </p>

  {
    entries.length === 0 ? (
      <p class="mt-6 rounded-box border-2 border-dashed border-base-300 p-6 text-base-content/70">
        No guides published yet.
      </p>
    ) : (
      [...groups.entries()].map(([label, group]) => (
        <section class="mt-8">
          <h2>{label}</h2>
          <CardGrid class="mt-4">
            {group.map((entry) => (
              <DocsCard
                config={docs}
                title={entry.data.title}
                description={entry.data.description}
                href={docsPath(slugFromId(entry.id))}
              />
            ))}
          </CardGrid>
        </section>
      ))
    )
  }
</DocsLayout>
