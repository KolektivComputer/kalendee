<configuration>
    <!--
      Default level is INFO: one access-log line per request (Ktor CallLogging),
      no SQL or routing TRACE noise. To debug, point JAVA_OPTS at a custom config
      and raise the root (or per-logger) level, for example:
        JAVA_OPTS="-Dlogback.configurationFile=/config/logback.xml"
      Set TRACE only while debugging; Exposed SQL lives under the "Exposed" logger.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <logger name="Exposed" level="INFO"/>
</configuration>
