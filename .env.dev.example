# Kalendee development environment (docker-compose.dev.yml).
#
# HOCON-file-first: non-secret settings belong in ./application.conf.dev,
# mounted at /config/application.conf. This file holds local secrets/defaults
# and the container-level knobs compose consumes.
#
#   cp .env.dev.example .env.dev
#   cp application.conf.dev.example application.conf.dev
#   docker compose -f docker-compose.dev.yml up
#
# For a host Gradle run (`./gradlew :server:run`), Gradle loads .env.local
# itself; this file is only read by compose. Never commit .env.dev.

# ---------------------------------------------------------------------------
# (a) Local credentials -- throwaway values for a dev stack.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=kalendee
KALENDEE_DATABASE_PASSWORD=kalendee
KALENDEE_ADMIN_PASSWORD=admin

# Optional: enable external calendars locally. Never use real production keys.
# Redirect URI: http://localhost:8080/api/v1/oauth/discord/callback
# KALENDEE_DISCORD_CLIENT_ID=
# KALENDEE_DISCORD_CLIENT_SECRET=
# KALENDEE_DISCORD_BOT_TOKEN=
# Redirect URI: http://localhost:8080/api/v1/oauth/google/callback
# KALENDEE_GOOGLE_CLIENT_ID=
# KALENDEE_GOOGLE_CLIENT_SECRET=
# Token encryption key. Generate with: openssl rand -base64 32
# KALENDEE_SECRET_KEY=
# KALENDEE_SECRET_KEYS=

# ---------------------------------------------------------------------------
# (b) Optional overrides -- defaults live in application.conf.dev / the image.
# ---------------------------------------------------------------------------

# Path to the HOCON file the Gradle-launched server loads. Matches the mount in
# docker-compose.dev.yml. Set empty to force pure env-var configuration.
# KALENDEE_CONFIG=/config/application.conf

# Dev bind/URL defaults from the config file: port 8080, baseUrl
# http://localhost:8080, cookieSecure=false, seedDemo=true (demo/demo).
# KALENDEE_HTTP_PORT=8080
# KALENDEE_HTTP_HOST=0.0.0.0
# KALENDEE_DATABASE_URL=jdbc:postgresql://postgres:5432/kalendee
# KALENDEE_DATABASE_USER=kalendee
# KALENDEE_PUBLIC_URL=http://localhost:8080
# KALENDEE_DEVELOPMENT=true
# KALENDEE_COOKIE_SECURE=false
# KALENDEE_SEED_DEMO=true
# KALENDEE_DEMO_PASSWORD=demo
# KALENDEE_DEMO_TIMEZONE=Europe/Berlin

# Exploded Keel pack inside the bind-mounted source tree. The dev config already
# sets this; override to point elsewhere.
# KALENDEE_KEEL_PACK=/src/server/pack/dist

# Mail in development defaults to the logging transport. Force it explicitly:
# KALENDEE_MAIL_ENABLED=false
# KALENDEE_MAIL_PROVIDER=log
# To test real delivery, use Mailgun's HTTP API (Cloudflare's send_email binding
# is a paid Email Routing feature):
# KALENDEE_MAIL_PROVIDER=mailgun
# KALENDEE_MAILGUN_API_KEY=change-me
# KALENDEE_MAILGUN_DOMAIN=mg.example.com
# KALENDEE_MAILGUN_REGION=us
# KALENDEE_MAILGUN_BASE_URL=
# KALENDEE_MAILGUN_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# (c) Compose-only variables -- consumed by docker-compose.dev.yml.
# ---------------------------------------------------------------------------

# Host port published for the server (container port is always 8080).
# KALENDEE_HOST_PORT=8080

# Host UID/GID the dev container runs as, so bind-mounted files keep ownership.
# On Docker Desktop (macOS/Windows) remove the `user:` line instead.
KALENDEE_UID=1000
KALENDEE_GID=1000

# Database bootstrap for the postgres service; must match the connection above.
POSTGRES_DB=kalendee
POSTGRES_USER=kalendee
