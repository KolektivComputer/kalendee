# Kalendee development environment.
#
# Read by docker-compose.dev.yml:
#
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml up

POSTGRES_DB=kalendee
POSTGRES_USER=kalendee
POSTGRES_PASSWORD=kalendee

KALENDEE_DATABASE_URL=jdbc:postgresql://postgres:5432/kalendee
KALENDEE_DATABASE_USER=kalendee
KALENDEE_DATABASE_PASSWORD=kalendee

KALENDEE_ADMIN_USERNAME=admin
KALENDEE_ADMIN_PASSWORD=admin

# Seed a demo user with sample calendars and events on startup.
# Log in as demo / demo to capture screenshots.
KALENDEE_SEED_DEMO=true
KALENDEE_DEMO_PASSWORD=demo
# KALENDEE_DEMO_TIMEZONE=Europe/Berlin

KALENDEE_DEVELOPMENT=true
# Plain-HTTP local development: session cookies must not require TLS.
KALENDEE_COOKIE_SECURE=false
KALENDEE_PUBLIC_URL=http://localhost:8080

# Pack dist directory inside the container (the repo is bind-mounted at /src).
KALENDEE_KEEL_PACK=/src/server/pack/dist

# Let the first registered account in automatically.
# KALENDEE_AUTH_REGISTRATION=first-user

# External calendars (optional).
# Redirect URI: http://localhost:8080/api/v1/oauth/discord/callback
# KALENDEE_DISCORD_CLIENT_ID=
# KALENDEE_DISCORD_CLIENT_SECRET=
# Bot token for reading guild scheduled events; invite the bot to the guild.
# KALENDEE_DISCORD_BOT_TOKEN=
# Token encryption key. Generate with: openssl rand -base64 32
# KALENDEE_SECRET_KEY=
# KALENDEE_SECRET_KEYS=
# KALENDEE_AUTH_OAUTH_REGISTRATION=false

# Host port to publish. Uncomment to change (defaults to 8080).
# KALENDEE_HOST_PORT=8080
